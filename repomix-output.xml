        </label>
        <br/>
        <label>
         <input name="szempont[]" type="checkbox" value="Esztétikus megjelenés"/>
         Esztétikus megjelenés
        </label>
        <br/>
        <label>
         <input name="szempont[]" type="checkbox" value="Alacsony fogyasztás"/>
         Alacsony fogyasztás
        </label>
        <br/>
        <label>
         <input name="szempont[]" type="checkbox" value="Csendes működés"/>
         Csendes működés
        </label>
        <br/>
        <label>
         <input name="szempont[]" type="checkbox" value="Halk kültéri egység"/>
         Halk kültéri egység
        </label>
        <br/>
        <label>
         <input name="szempont[]" type="checkbox" value="Wi-Fi"/>
         Okostelefonos vezérlés (Wi-Fi)
        </label>
        <br/>
        <label>
         <input name="szempont[]" type="checkbox" value="Megbízhatóság"/>
