                openModalBtn.addEventListener("click", function (e) {
                    e.preventDefault();
                    modal.style.display = "block";
                });
                closeModalBtn.addEventListener("click", function () {
                    modal.style.display = "none";
                });
                window.addEventListener("click", function (e) {
                    if (e.target === modal) {
                        modal.style.display = "none";
                    }
                });
            }
