  <script>
   function toggleFelmérés() {
        const val = document.getElementById("felmeresSelect").value;
        const helyszini = document.getElementById("helyszini-fields");
        const online = document.getElementById("online-fields");
        const title = document.getElementById("form-title");
        const desc = document.getElementById("form-description");
        helyszini.style.display = "none";
        online.style.display = "none";
        if (val === "helyszini") {
          helyszini.style.display = "block";
          title.innerText = "Ingyenes Helyszíni felmérés";
          desc.innerHTML =
            "Szakértő kollégánk kiszáll a helyszínre, hogy pontos ajánlatot készíthessünk. A felmérés ingyenes, vásárlási kötelezettség nélkül.";
        }
        if (val === "online") {
          online.style.display = "block";
          title.innerText = "Ingyenes Online felmérés";
          desc.innerHTML =
            "Nem szeretnél időpontot egyeztetni? Kényelmes, otthoni megoldás fotók és alaprajz alapján. Töltsd ki az alábbi mezőket.";
        }
      }
      (function () {
        emailjs.init("1CqvyW2ydm0WkaVAU");
      })();
      document
        .getElementById("survey-form")
        .addEventListener("submit", function (e) {
          e.preventDefault();
          // 🔧 Ez hiányzott: összefűzzük a pipált checkboxokat a rejtett mezőbe
          const selected = [
            ...document.querySelectorAll('input[name="szempont[]"]:checked'),
          ]
            .map((cb) => cb.value)
            .join(", ");
          document.getElementById("szempont_osszefuzve").value = selected;
          emailjs.sendForm("service_jpdwm24", "template_tt47zmn", this).then(
            function () {
              alert("Köszönjük! A felmérés sikeresen elküldve.");
              document.getElementById("survey-form").reset();
              document.getElementById("helyszini-fields").style.display =
                "none";
              document.getElementById("online-fields").style.display = "none";
              document.getElementById("form-title").innerText =
                "Előzetes klímafelmérés";
              document.getElementById("form-description").innerText =
                "Kérjük, válassz, milyen típusú felmérést szeretnél!";
            },
            function (error) {
              alert("Hiba történt a beküldés során: " + JSON.stringify(error));
            }
          );
        });
  </script>
