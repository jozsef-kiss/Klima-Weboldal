            const openModalBtn = document.getElementById("openStandardModal");
            const modal = document.getElementById("standardModal");
            const closeModalBtn = document.querySelector(".close-standard");
            if (openModalBtn && modal && closeModalBtn) {
                openModalBtn.addEventListener("click", function (e) {
                    e.preventDefault();
                    modal.style.display = "block";
                });
                closeModalBtn.addEventListener("click", function () {
                    modal.style.display = "none";
                });
                window.addEventListener("click", function (e) {
                    if (e.target === modal) {
                        modal.style.display = "none";
                    }
                });
            }
            // SAFETY MODAL - dinamikusan beszúrt gombokra figyel
            document.addEventListener("click", function (e) {
                if (e.target.closest("#openSafetyModal")) {
                    e.preventDefault();
                    const safetyModal = document.getElementById("safetyModal");
                    if (safetyModal) {
                        safetyModal.style.display = "block";
                    }
                }
                if (e.target.matches("#closeSafetyModal")) {
                    document.getElementById("safetyModal").style.display = "none";
                }
                if (e.target === document.getElementById("safetyModal")) {
                    document.getElementById("safetyModal").style.display = "none";
                }
            });
        });
